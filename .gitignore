# Generated by XcodeGen from project.yml. Never committed: a pbxproj conflicts on every
# branch and nobody reviews it.
*.xcodeproj/
*.xcworkspace/

# Xcode
xcuserdata/
DerivedData/
build/
*.xcuserstate

# macOS
.DS_Store

# Swift Package Manager
.swiftpm/
.build/
Packages/

# Python, for the two contract tests
__pycache__/
*.pyc

# The engine venv, created by scripts/setup-engine.sh
.venv/

# SwiftPM build products for the WhisperKit service
whisperkit-service/.build/

# Cached relocatable Python for packaging
.cache/
dist/

# Working directory for model weights, at the repository root only. Reproducible from
# scripts/fetch-speaker-model.sh, and the same arrangement the Windows build uses.
#
# Anchored with a leading slash, and that is load-bearing: an unanchored `models/` matches any
# directory of that name at any depth, and on a case-insensitive filesystem it also matches
# `Sunno/Models/`, which quietly excluded two Swift source files from a commit.
/models/
